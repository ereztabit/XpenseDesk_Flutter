{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Dev (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "flutter pub get",
      "args": [
        "-d",
        "chrome",
        "--web-hostname",
        "127.0.0.1",
        "--web-port=8080",
        "--dart-define=ENV=dev"
      ]
    },
    {
      "name": "Flutter Prod (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "flutter pub get",
      "args": [
        "-d",
        "chrome",
        "--web-hostname",
        "127.0.0.1",
        "--web-port=8080",
        "--dart-define=ENV=prod"
      ]
    },
    {
      "name": "Flutter Dev HTTPS (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "flutter pub get",
      "args": [
        "-d",
        "chrome",
        "--web-hostname",
        "localhost",
        "--web-port=8080",
        "--web-tls-cert-path",
        "localhost+1.pem",
        "--web-tls-cert-key-path",
        "localhost+1-key.pem",
        "--dart-define=ENV=dev"
      ]
    },
    {
      "name": "Flutter Dev (Web Server - External)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "flutter pub get",
      "args": [
        "-d",
        "web-server",
        "--web-hostname",
        "0.0.0.0",
        "--web-port",
        "8080",
        "--dart-define=ENV=dev"
      ]
    }
  ]
}
