{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xpensedesk-flutter",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname=localhost",
        "--web-port=8080",
        "--web-tls-cert-path=localhost+1.pem",
        "--web-tls-cert-key-path=localhost+1-key.pem",
        "--dart-define=ENV=dev"
      ],
      "port": 8080,
      "url": "https://localhost:8080"
    }
  ]
}
